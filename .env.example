# Private key of the DEDICATED Register deploy wallet. Never reuse the
# niara-contracts-PMEs key (risk isolation between products). It needs a
# little Sepolia ETH (public faucet; 0.01-0.05 ETH is enough).
PRIVATE_KEY=

# Same Alchemy RPC used across the Niara project.
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/

# Optional: only needed to verify the contract on Etherscan
# (forge script ... --verify). Without it the deploy works normally,
# the source code just isn't publicly readable on Etherscan.
ETHERSCAN_API_KEY=
