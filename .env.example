# Chave privada da carteira DEDICADA de deploy do Register — nunca reusar a
# do niara-contracts-PMEs (isolamento de risco entre produtos). Precisa ter
# um pouco de Sepolia ETH (faucet público, 0.01-0.05 ETH já é suficiente).
PRIVATE_KEY=

# Mesmo RPC da Alchemy usado no resto do projeto Niara.
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/

# Opcional — só necessário se for verificar o contrato no Etherscan
# (forge script ... --verify). Sem isso, o deploy funciona normalmente,
# só não fica com o código-fonte legível publicamente no Etherscan.
ETHERSCAN_API_KEY=
